# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your_s3_bucket_name

# Database Configuration
DB_HOST=your_rds_endpoint
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# SMTP / Email Configuration
# For Gmail: enable 2-Step Verification, then create a 16-char App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
MAIL_FROM=your_email@gmail.com
MAIL_FROM_NAME=SARDO360

# Two-Factor Authentication (Email OTP)
# OTP_RECIPIENT = superadmin/production inbox that receives login codes when deployed
OTP_RECIPIENT=your_email@gmail.com
# OTP_TEST_RECIPIENT = testing override; while set, codes go here instead.
# Supports comma-separated addresses. Leave BLANK on deployment.
OTP_TEST_RECIPIENT=
