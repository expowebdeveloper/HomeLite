# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your_s3_bucket_name

# Database Configuration
DB_HOST=your_rds_endpoint
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# SMTP / Email Configuration
# For Gmail: enable 2-Step Verification, then create a 16-char App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
MAIL_FROM=your_email@gmail.com
MAIL_FROM_NAME=SARDO360

# Two-Factor Authentication (Email OTP)
# OTP_RECIPIENT = superadmin/production inbox that receives login codes when deployed
OTP_RECIPIENT=your_email@gmail.com
# OTP_TEST_RECIPIENT = testing override; while set, codes go here instead.
# Supports comma-separated addresses. Leave BLANK on deployment.
OTP_TEST_RECIPIENT=

# ---------------------------------------------------------------------------
# Security keys
# Anything left unset falls back to a value hard-coded in app/config.py.
# The app logs a warning at startup for each one still on its default.
# ---------------------------------------------------------------------------
# REQUIRED. Flask session signing key. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=default-dev-key
# REQUIRED. Application secret; also the fallback for JWT_SECRET_KEY.
SECRET_KEY=default-dev-key
# Defaults to SECRET_KEY. Set separately to rotate API tokens on their own.
JWT_SECRET_KEY=
# REQUIRED. Fernet key encrypting stored TOTP secrets.
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=x_uJvYq82bW40P-ZfJ0o1W7aM8R3_59gXhT3iYf1cHg=

# ---------------------------------------------------------------------------
# Tokens, OTP and misc
# ---------------------------------------------------------------------------
# Digits in an emailed login code.
OTP_LENGTH=6
# How long a login code stays valid.
OTP_EXPIRY_SECONDS=300
# Wrong-code attempts before the code is burned.
OTP_MAX_ATTEMPTS=5
# Minimum wait between resend requests.
OTP_RESEND_COOLDOWN_SECONDS=30
# Best-effort country lookup from IP via a public API. False to skip.
GEO_LOOKUP_ENABLED=True
# Base URL used when building password-reset links.
FRONTEND_URL=http://localhost:3000
# Access token lifetime in seconds (default 900 = 15 min).
JWT_ACCESS_EXPIRY=900
# Refresh token lifetime in seconds (default 604800 = 7 days).
JWT_REFRESH_EXPIRY=604800
